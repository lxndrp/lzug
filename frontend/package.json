{
  "name": "frontend",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json --poll 1000 --host 127.0.0.1",
    "build": "../scripts/build-frontend.sh",
    "build:ci": "../scripts/build-frontend.sh",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "test:coverage": "ng test --watch=false --coverage",
    "test:e2e": "node e2e/run-playwright.mjs --project=chromium --grep-invert '@a11y|@ui-review' && npm run build:ci && LZUG_E2E_PRODUCTION_BUILD=true node e2e/run-playwright.mjs production-build.spec.ts",
    "test:a11y": "node e2e/run-playwright.mjs --grep @a11y",
    "test:ui-review": "node e2e/run-playwright.mjs ui-review.spec.ts",
    "test:publication": "LZUG_PUBLICATION_SUITE=browser node e2e/run-playwright.mjs --config playwright.publication.config.ts",
    "test:publication:a11y": "LZUG_PUBLICATION_SUITE=a11y node e2e/run-playwright.mjs --config playwright.publication.config.ts",
    "docs": "typedoc --treatWarningsAsErrors --entryPointStrategy expand --entryPoints src/app --out ../site/developers/reference/frontend",
    "security:check": "npm audit --omit=dev --audit-level=critical",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check ."
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      },
      {
        "files": "*.svg",
        "options": {
          "parser": "html"
        }
      }
    ]
  },
  "private": true,
  "overrides": {
    "fast-uri": "3.1.6"
  },
  "dependencies": {
    "@angular/aria": "^22.1.5",
    "@angular/cdk": "^22.0.3",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/router": "^22.1.4",
    "@fontsource-variable/inter": "5.3.0",
    "@taiga-ui/addon-table": "^5.22.0",
    "@taiga-ui/core": "^5.22.0",
    "@taiga-ui/i18n": "^5.22.0",
    "@taiga-ui/icons": "^5.22.0",
    "@taiga-ui/kit": "^5.22.0",
    "@taiga-ui/layout": "^5.22.0",
    "lucide": "0.468.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@resvg/resvg-js": "2.6.2",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^30.0.1",
    "less": "^4.9.0",
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
