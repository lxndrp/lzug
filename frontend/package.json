{
  "name": "frontend",
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json --poll 1000 --host 127.0.0.1",
    "build": "ng build",
    "build:ci": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "test:coverage": "ng test --watch=false --coverage",
    "test:e2e": "node e2e/run-playwright.mjs --grep-invert @a11y",
    "test:a11y": "node e2e/run-playwright.mjs --grep @a11y",
    "docs": "typedoc --treatWarningsAsErrors --entryPointStrategy expand --entryPoints src/app --out ../site/developers/reference/frontend",
    "security:check": "npm audit --omit=dev --audit-level=critical",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check ."
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      },
      {
        "files": "*.svg",
        "options": {
          "parser": "html"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/aria": "^22.1.1",
    "@angular/cdk": "^22.0.3",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@taiga-ui/addon-table": "^5.18.0",
    "@taiga-ui/core": "^5.18.0",
    "@taiga-ui/i18n": "^5.18.0",
    "@taiga-ui/icons": "^5.18.0",
    "@taiga-ui/kit": "^5.18.0",
    "@taiga-ui/layout": "^5.18.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^30.0.1",
    "less": "^4.8.1",
    "prettier": "^3.9.6",
    "sass": "^1.101.0",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
