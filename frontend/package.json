{
  "name": "frontend",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "pwsh -NoProfile -File ../scripts/build-frontend.ps1 -Serve",
    "build": "pwsh -NoProfile -File ../scripts/build-frontend.ps1",
    "build:ci": "pwsh -NoProfile -File ../scripts/build-frontend.ps1",
    "watch": "pwsh -NoProfile -File ../scripts/build-frontend.ps1 -Watch",
    "test": "ng test",
    "test:ci": "pwsh -NoProfile -File ../scripts/build-frontend.ps1 -Test",
    "test:coverage": "pwsh -NoProfile -File ../scripts/build-frontend.ps1 -Test -Coverage",
    "architecture:check": "node scripts/validate-architecture-boundaries.mjs",
    "test:e2e": "npm run test:e2e:development && npm run build:ci && npm run test:e2e:production",
    "test:e2e:development": "node e2e/run-playwright.mjs --project=chromium --grep-invert '@a11y|@ui-review'",
    "test:e2e:production": "LZUG_E2E_PRODUCTION_BUILD=true node e2e/run-playwright.mjs production-build.spec.ts",
    "test:a11y": "node e2e/run-playwright.mjs --grep @a11y",
    "test:ui-review": "node e2e/run-playwright.mjs ui-review.spec.ts",
    "test:publication": "LZUG_PUBLICATION_SUITE=browser node e2e/run-playwright.mjs --config playwright.publication.config.ts",
    "test:publication:a11y": "LZUG_PUBLICATION_SUITE=a11y node e2e/run-playwright.mjs --config playwright.publication.config.ts",
    "docs": "typedoc --out ../site/developers/reference/frontend",
    "security:check": "npm audit --omit=dev --audit-level=critical",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check ."
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      },
      {
        "files": "*.svg",
        "options": {
          "parser": "html"
        }
      }
    ]
  },
  "private": true,
  "overrides": {
    "@hey-api/json-schema-ref-parser@1.4.4": {
      "js-yaml": "4.3.2"
    }
  },
  "dependencies": {
    "@angular/aria": "~22.2.0",
    "@angular/cdk": "~22.2.0",
    "@angular/common": "~22.2.0",
    "@angular/compiler": "~22.2.0",
    "@angular/core": "~22.2.0",
    "@angular/forms": "~22.2.0",
    "@angular/platform-browser": "~22.2.0",
    "@angular/router": "~22.2.0",
    "@fontsource-variable/inter": "5.3.0",
    "@taiga-ui/addon-table": "^5.25.0",
    "@taiga-ui/core": "^5.25.0",
    "@taiga-ui/i18n": "^5.25.0",
    "@taiga-ui/icons": "^5.25.0",
    "@taiga-ui/kit": "^5.25.0",
    "@taiga-ui/layout": "^5.25.0",
    "lucide": "1.49.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular/build": "~22.2.0",
    "@angular/cli": "~22.2.0",
    "@angular/compiler-cli": "~22.2.0",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "2.6.2",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "~5.0.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^30.1.1",
    "less": "^4.9.1",
    "prettier": "^3.9.9",
    "sass": "^1.105.0",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "~5.0.2"
  }
}
