# syntax=docker/dockerfile:1

FROM python:3.14.6-slim-bookworm AS backend-build

COPY --from=ghcr.io/astral-sh/uv:0.11.28 /uv /uvx /bin/
WORKDIR /src
COPY LICENSE pyproject.toml ./
COPY backend/src ./backend/src
RUN uv build --wheel --out-dir /dist

FROM python:3.14.6-slim-bookworm AS python-dependencies

COPY --from=ghcr.io/astral-sh/uv:0.11.28 /uv /uvx /bin/
WORKDIR /src
COPY pyproject.toml uv.lock ./
COPY --from=backend-build /dist/*.whl /dist/
RUN uv sync --locked --no-dev --no-install-project --no-editable --compile-bytecode --no-cache
RUN mkdir -p /src/backend/src \
    && uv pip install --python /src/.venv/bin/python --target /src/backend/src \
       --no-deps /dist/*.whl

FROM python:3.14.6-slim-bookworm AS seed-build

ARG PRODUCT_TAG
ARG VCS_REF
ENV PATH="/opt/venv/bin:$PATH" PYTHONPATH="/src/backend/src:/src"
WORKDIR /src
COPY --from=python-dependencies /src/.venv /opt/venv
COPY --from=python-dependencies /src/backend/src ./backend/src
COPY backend/db ./backend/db
COPY demo ./demo
COPY fixtures ./fixtures
COPY scripts ./scripts
RUN set -eu; \
    test -n "$PRODUCT_TAG"; \
    test -n "$VCS_REF"; \
    python -m demo.artifacts build-seed --source-root /src \
      --database /seed/lzug.sqlite --manifest /seed/manifest.json \
      --product-tag "$PRODUCT_TAG" --product-commit "$VCS_REF"; \
    test ! -e /seed/lzug.sqlite-wal; \
    test ! -e /seed/lzug.sqlite-shm

FROM python:3.14.6-slim-bookworm AS runtime

ARG PRODUCT_TAG
ARG VCS_REF
LABEL org.opencontainers.image.title="lzug-demo-seed" \
      org.opencontainers.image.description="Content-addressed synthetic lzug seed initializer" \
      org.opencontainers.image.source="https://github.com/lxndrp/lzug" \
      org.opencontainers.image.version="$PRODUCT_TAG" \
      org.opencontainers.image.revision="$VCS_REF"

ENV PYTHONPATH="/app/backend/src" PYTHONDONTWRITEBYTECODE="1" PYTHONUNBUFFERED="1"
WORKDIR /app

RUN groupadd --system --gid 10001 lzug \
    && useradd --system --uid 10001 --gid 10001 --home-dir /nonexistent \
       --shell /usr/sbin/nologin lzug \
    && mkdir -p /app/backend/src /app/backend/db/migrations /app/demo /opt/lzug-demo/seed /data \
    && chown -R 10001:10001 /app /opt/lzug-demo /data

COPY --from=python-dependencies --chown=10001:10001 /src/backend/src ./backend/src
COPY --chown=10001:10001 backend/db ./backend/db
COPY --chown=10001:10001 demo/__init__.py demo/artifacts.py demo/contract.py demo/identity.py ./demo/
COPY --from=seed-build --chown=10001:10001 /seed/lzug.sqlite /opt/lzug-demo/seed/lzug.sqlite
COPY --from=seed-build --chown=10001:10001 /seed/manifest.json /opt/lzug-demo/seed/manifest.json

USER 10001:10001
ENTRYPOINT ["python", "-m", "demo.artifacts", "init"]
CMD ["--seed-database", "/opt/lzug-demo/seed/lzug.sqlite", "--seed-manifest", "/opt/lzug-demo/seed/manifest.json", "--target", "/data"]
