{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Tests ausfuehren",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "-m",
                "unittest"
            ],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Frontend Tests",
            "type": "shell",
            "command": "npm",
            "args": [
                "run",
                "test:ci"
            ],
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Frontend Coverage",
            "type": "shell",
            "command": "npm",
            "args": [
                "run",
                "test:coverage"
            ],
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Frontend Build",
            "type": "shell",
            "command": "npm",
            "args": [
                "run",
                "build:ci"
            ],
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Alle Tests",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Tests ausfuehren",
                "Frontend Tests"
            ],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Tests mit Coverage",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "-m",
                "coverage",
                "run",
                "-m",
                "unittest"
            ],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Coverage XML erzeugen",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "-m",
                "coverage",
                "xml"
            ],
            "dependsOn": "Tests mit Coverage",
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Coverage HTML erzeugen",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "-m",
                "coverage",
                "html"
            ],
            "dependsOn": "Tests mit Coverage",
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Alle Coverage Reports",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Coverage XML erzeugen",
                "Frontend Coverage"
            ],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Backend starten",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "-m",
                "server.app",
                "--init",
                "--seed",
                "--reset"
            ],
            "group": "build",
            "isBackground": true,
            "problemMatcher": []
        }
    ]
}
