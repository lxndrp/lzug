{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Entwicklungsumgebung einrichten",
            "type": "shell",
            "command": "mise",
            "args": ["exec", "--", "task", "setup"],
            "problemMatcher": []
        },
        {
            "label": "Frontend starten",
            "type": "shell",
            "command": "mise",
            "args": ["exec", "--", "task", "dev:frontend"],
            "isBackground": true,
            "problemMatcher": {
                "owner": "lzug-frontend",
                "pattern": {
                    "regexp": "^.*$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*Building.*$",
                    "endsPattern": "^.*Local:.*http://127\\.0\\.0\\.1:4200/.*$"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "Backend starten",
            "type": "shell",
            "command": "mise",
            "args": ["exec", "--", "task", "dev:backend"],
            "group": "build",
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Unit-Tests",
            "type": "shell",
            "command": "mise",
            "args": ["exec", "--", "task", "test"],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Backend-Qualität",
            "type": "shell",
            "command": "mise",
            "args": ["exec", "--", "task", "quality:backend"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Frontend-Qualität",
            "type": "shell",
            "command": "mise",
            "args": ["exec", "--", "task", "quality:frontend"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "End-to-End-Tests",
            "type": "shell",
            "command": "mise",
            "args": ["exec", "--", "task", "quality:e2e"],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Accessibility-Tests",
            "type": "shell",
            "command": "mise",
            "args": ["exec", "--", "task", "quality:a11y"],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Frontend-Sicherheitsprüfung",
            "type": "shell",
            "command": "mise",
            "args": ["exec", "--", "task", "quality:security"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Dokumentation bauen",
            "type": "shell",
            "command": "mise",
            "args": ["exec", "--", "task", "docs"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Qualität vollständig prüfen",
            "type": "shell",
            "command": "mise",
            "args": ["exec", "--", "task", "quality"],
            "group": "build",
            "problemMatcher": []
        }
    ]
}
