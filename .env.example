# Required: use a published immutable SemVer tag or digest from GitHub Releases.
# Examples: ghcr.io/lxndrp/lzug:1.2.3 or ghcr.io/lxndrp/lzug@sha256:<digest>.
# Never use :latest. For a local build, use for example lzug:0.1.0-local.
LZUG_IMAGE=

# Bind only to loopback by default; an existing reverse proxy can reach this port.
LZUG_BIND_ADDRESS=127.0.0.1
LZUG_HOST_PORT=8000
# Container-side values are normally left at these image defaults.
# LZUG_HOST=0.0.0.0
# LZUG_PORT=8000
# LZUG_STATIC_DIR=/app/frontend
# LZUG_HEALTHCHECK_URL=http://127.0.0.1:8000/api/health

# HTTPS is mandatory by default: secure cookies and HSTS stay enabled behind
# the reverse proxy. Use false only for an explicitly local HTTP-only test.
LZUG_HTTPS_ONLY=true
# Empty means same-origin only. Never use a wildcard; list exact origins comma-separated.
LZUG_CORS_ALLOWED_ORIGINS=
LZUG_SESSION_TTL_SECONDS=28800
LZUG_MAX_REQUEST_BYTES=1048576
LZUG_AUTH_RATE_LIMIT=20
LZUG_AUTH_RATE_WINDOW_SECONDS=60
LZUG_MAX_UPLOAD_BYTES=10485760
LZUG_ALLOWED_UPLOAD_MEDIA_TYPES=application/pdf,image/jpeg,image/png,text/plain

# Keep this name stable across upgrades and reinstalls to retain /data.
LZUG_DATA_VOLUME=lzug_data

# Optional runtime overrides. Keep the defaults below the /data contract.
# LZUG_DATABASE_PATH=/data/lzug.sqlite
# LZUG_DATABASE_URL=
# LZUG_DOCUMENTS_PATH=/data/documents
# LZUG_BACKUPS_PATH=/data/backups
